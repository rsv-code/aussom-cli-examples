 * Game:
 * The player shoots from a "cannon" toward the mouse cursor and tries
 * to drop the projectile between the two barriers so it lands on the
 * hidden ground strip, scoring 1000 points per hit.
 */

include fx;
include fx.Rectangle;
include fx.Color;
include fx.Text;
include fxgl;
include fxgl.Entity;
include fxgl.GameSettings;
include fxgl.GameWorld;
include fxgl.GameScene;
include fxgl.ExpireCleanComponent;
include fxgl.LiftComponent;
include fxgl.PhysicsComponent;
include fxgl.PhysicsWorld;
include fxgl.CollidableComponent;
include fxgl.CollisionHandler;
include fxgl.UserAction;
include fxgl.Input;
include fxgl.Vec2;
include fxgl.UIFactoryService;
include fx.IntegerProperty;
include fx.StringProperty;

/**
 * Drives a single bullet: applies the launch velocity once the physics
 * body has been created. Expiry is handled by an `ExpireCleanComponent`
 * attached separately to the bullet entity.
 */
class Bullet {
    /** The bullet's PhysicsComponent. */
    public physics = null;
    /** Launch velocity X in pixels per second. */
    public vx = 0.0;
    /** Launch velocity Y in pixels per second. */
    public vy = 0.0;

    /**
     * Builds a dynamic-body PhysicsComponent. The launch velocity is
     * applied as soon as the physics body is created via
     * onPhysicsInitialized.
     * @p Vx is the launch velocity X in pixels per second.
     * @p Vy is the launch velocity Y in pixels per second.
     */
    public Bullet(double Vx, double Vy) {
        this.vx = Vx;
        this.vy = Vy;

        this.physics = new PhysicsComponent();
        this.physics.setBodyType("DYNAMIC");
        this.physics.setDensity(0.05);
        this.physics.onPhysicsInitialized(::applyVelocity);
    }

    /**
     * Applies the stored launch velocity. Invoked by FXGL when the
     * physics body has been created.
     */
    public applyVelocity() {
        this.physics.setLinearVelocity(this.vx, this.vy);
    }
}

/**
 * The Cannon game application. Wires the FXGL lifecycle callbacks and
 * builds the cannon, barriers, ground, bullets, collision scoring, and
 * the score readout.
 */
class CannonApp {
    /** Game window width in pixels. */
    public width = 800;
    /** Game window height in pixels. */
    public height = 600;

    /** The fxglApp returned by fxgl.gameApp. */
    public app = null;
    /** The running game's GameWorld wrapper. */
    public world = null;
    /** The running game's Input wrapper. */
    public input = null;
    /** The cannon Entity wrapper. */
    public cannon = null;
    /** The score Text wrapper. */
    public scoreText = null;
    /** Keeps live Bullet controllers reachable. */
    public bullets = [];

    /**
     * The app entry point. Configures the lifecycle callbacks and
     * launches the game in standalone mode.
     * @p args is a list of command line arguments.
     */
    public main(args) {
        this.build("Cannon");
        this.app.launch();
    }

    /**
     * Creates the fxglApp and registers the game's lifecycle callbacks
     * without launching. Tests use this to attach a driving onUpdate
     * before calling launch.
     * @p Title is the game window title.
     * @r The configured fxglApp.
     */
    public build(string Title) {
        this.app = fxgl.gameApp(Title, this.width, this.height);
        this.app.onInitSettings(::onInitSettings);
        this.app.onInitInput(::onInitInput);
        this.app.onInitGame(::onInitGame);
        this.app.onInitPhysics(::onInitPhysics);
        this.app.onInitUI(::onInitUI);
        return this.app;
    }

    /**
     * Disables FXGL's filesystem writes (the `logs/` and `system/`
     * directories it would otherwise create in the working directory).
     * @p Settings is the GameSettings wrapper.
     */
    public onInitSettings(object Settings) {
        Settings.setVersion("0.2.1");
        Settings.setFileSystemWriteAllowed(false);
        Settings.setUserProfileEnabled(false);
    }

    /**
     * @r The current score from the FXGL world properties.
     */
    public getScore() { return fxgl.geti("score"); }

    /**
     * Binds the left mouse button to the shoot action.
     */
    public onInitInput() {
        this.input = fxgl.getInput();

        action = new UserAction("Shoot");
        action.onActionBegin(::shoot);
        this.input.addActionMouse(action, "PRIMARY");
    }

    /**
     * Builds the static world: screen bounds, cannon, and basket.
     */
    public onInitGame() {
        this.world = fxgl.getGameWorld();
        fxgl.set("score", 0);
        fxgl.buildScreenBoundsAndAttach(100.0);
        this.initCannon();
        this.initBasket();
    }

    /**
     * Spawns the cannon: a brown box on the left that bobs up and down
     * via a LiftComponent.
     */
    public initCannon() {
        this.cannon = new Entity();
        this.cannon.setType("CANNON");
        this.cannon.setPosition(50.0, this.height - 300.0);
        this.addRectView(this.cannon, 70.0, 30.0, new Color("#A52A2A"));

        lift = new LiftComponent();
        lift.yAxisSpeedDuration(150.0, 1.0);
        this.cannon.addComponent(lift);

        this.world.addEntity(this.cannon);
    }

    /**
     * Spawns the two barriers and the hidden ground strip between them.
     */
    public initBasket() {
        this.spawnBarrier(400.0, this.height - 300.0);
        this.spawnBarrier(700.0, this.height - 300.0);
        this.spawnGround(500.0, this.height);
    }

    /**
     * Spawns a solid red barrier. Barriers block bullets physically but
     * are not collidable, so they do not score.
     * @p X is the barrier X position.
     * @p Y is the barrier Y position.
     */
    public spawnBarrier(double X, double Y) {
        e = new Entity();
        e.setType("BASKET");
        e.setPosition(X, Y);
        this.addRectView(e, 100.0, 300.0, new Color("#FF0000"));
        e.addBoundingBox(100.0, 300.0);
        e.addComponent(new PhysicsComponent());
        this.world.addEntity(e);
    }

    /**
     * Spawns the transparent, collidable ground strip. A bullet landing
     * here triggers the score.
     * @p X is the ground X position.
     * @p Y is the ground Y position.
     */
    public spawnGround(double X, double Y) {
        e = new Entity();
        e.setType("BASKET");
        e.setPosition(X, Y);
        this.addRectView(e, 300.0, 5.0, new Color("#000000", 0.0));
        e.addBoundingBox(300.0, 5.0);
        e.addComponent(new CollidableComponent(true));
        e.addComponent(new PhysicsComponent());
        this.world.addEntity(e);
    }

    /**
     * Fires a bullet from the cannon's muzzle toward the mouse cursor.
     */
    public shoot() {
        startX = this.cannon.getX() + 70.0;
        startY = this.cannon.getY();

        direction = new Vec2(this.input.getMouseXWorld() - startX, this.input.getMouseYWorld() - startY);
        direction.normalizeLocal();

        this.spawnBullet(startX, startY, direction.getX() * 800.0, direction.getY() * 800.0);
    }

    /**
     * Spawns a blue bullet with the given start position and velocity.
     * The bullet is collidable, has a dynamic physics body driven by a
     * Bullet controller, and removes itself after four seconds via an
     * ExpireCleanComponent.
     * @p StartX is the spawn X position.
     * @p StartY is the spawn Y position.
     * @p Vx is the launch velocity X in pixels per second.
     * @p Vy is the launch velocity Y in pixels per second.
     * @r The bullet Entity wrapper.
     */
    public spawnBullet(double StartX, double StartY, double Vx, double Vy) {
        e = new Entity();
        e.setType("BULLET");
        e.setPosition(StartX, StartY);
        this.addRectView(e, 25.0, 25.0, new Color("#0000FF"));
        e.addBoundingBox(25.0, 25.0);
        e.addComponent(new CollidableComponent(true));

        ball = new Bullet(Vx, Vy);
        e.addComponent(ball.physics);
        e.addComponent(new ExpireCleanComponent(4.0));
        this.bullets.add(ball);

        this.world.addEntity(e);
        return e;
    }

    /**
     * Registers the bullet/basket collision handler that scores hits.
     */
    public onInitPhysics() {
        handler = new CollisionHandler("BULLET", "BASKET");
        handler.onCollisionBegin(::onBulletHitBasket);
        fxgl.getPhysicsWorld().addCollisionHandler(handler);
    }

    /**
     * Removes the bullet and adds to the score when a bullet lands on
     * the collidable ground.
     * @p BulletEntity is the bullet Entity wrapper.
     * @p BasketEntity is the ground Entity wrapper.
     */
    public onBulletHitBasket(object BulletEntity, object BasketEntity) {
        BulletEntity.removeFromWorld();
        fxgl.inc("score", 1000);
    }

    /**
     * Builds the score readout in the top-right of the screen. The
     * label is a UI-factory-produced Text bound to the "score" world
     * var via IntegerProperty.asString("Score: [%d]"), matching the
     * original Java bind pattern exactly.
     */
    public onInitUI() {
        uifac = fxgl.getUIFactoryService();
        textAjo = uifac.obj.invokeRaw("newText", "", new Color("#000000").obj, 24.0);
        this.scoreText = new Text();
        this.scoreText.obj = textAjo;

        scoreProp = new IntegerProperty();
        scoreProp.obj = fxgl.getip("score");
        binding = scoreProp.asString("Score: [%d]");

        textProp = new StringProperty();
        textProp.obj = this.scoreText.textProperty();
        textProp.bind(binding);

        fxgl.addUINodeAt(this.scoreText, 550.0, 100.0);
    }

    /**
     * Adds a filled rectangle view to an entity.
     * @p EntityObj is the Entity wrapper to add the view to.
     * @p W is the rectangle width.
     * @p H is the rectangle height.
     * @p ColorObj is the fill Color wrapper.
     */
    public addRectView(object EntityObj, double W, double H, object ColorObj) {
        rect = new Rectangle(0.0, 0.0, W, H);
        rect.setFill(ColorObj);
        EntityObj.addViewNode(rect);
    }
}
